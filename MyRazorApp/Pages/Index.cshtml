@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<!--prompt:  Create a page and Left side I want to add class and Left side input will show my classes and Its informations.-->
<div class="container mt-5">
    <div class="row">
        <!-- Form (Left Side) -->
        <div class="col-md-4">
            <h3>@(Model.IsEdit ? "Edit Class" : "Add Class")</h3>
            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="NewClass.ClassName" class="form-label">Class Name</label>
                    <input asp-for="NewClass.ClassName" class="form-control" required>
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewClass.StudentCount" class="form-label">Student Count</label>
                    <input asp-for="NewClass.StudentCount" class="form-control" required>
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewClass.ClassDescription" class="form-label">Description</label>
                    <textarea asp-for="NewClass.ClassDescription" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.ClassDescription" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary" asp-page-handler="@(Model.IsEdit ? "Update" : "Add")">@(Model.IsEdit ? "Update Class" : "Add Class")</button>
            </form>
        </div>

        <!-- Table (Right Side) -->

        <div class="col-md-8">
            <h3>Class List</h3>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in IndexModel.ClassList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.ClassDescription</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-warning btn-sm" asp-page-handler="Edit">Edit</button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" asp-page-handler="Delete">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
