@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class List";
}

<h1>Class List</h1>

<div class="row">
    <div class="col-md-6">
        <h2>@(Model.IsEdit ? "Edit Class" : "Add New Class")</h2>
        <form method="post" asp-page-handler="@(Model.IsEdit ? "Update" : "Add")">
            <input type="hidden" asp-for="ClassInformation.Id" />
            <div class="form-group">
                <label asp-for="ClassInformation.ClassName">ClassName</label>
                <input asp-for="ClassInformation.ClassName" class="form-control" />
                <span asp-validation-for="ClassInformation.ClassName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClassInformation.StudentCount">StudentCount</label>
                <input asp-for="ClassInformation.StudentCount" class="form-control" type="number" />
                <span asp-validation-for="ClassInformation.StudentCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClassInformation.ClassDescription">ClassDescription</label>
                <input asp-for="ClassInformation.ClassDescription" class="form-control" />
                <span asp-validation-for="ClassInformation.ClassDescription" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Update" : "Add")</button>
        </form>
    </div>
    <div class="col-md-6">
        <h2>Class List</h2>
        <form method="get">
            <div class="form-group">
                <label for="FilterBy">Filter by Class Name or Description</label>
                <input type="text" class="form-control" id="FilterBy" name="FilterBy" value="@Model.FilterBy" />
            </div>
            <button type="submit" class="btn btn-secondary">Filter</button>
        </form>
        <br />
        <table class="table">
            <thead>
                <tr>
                    <th>Class Name</th>
                    <th>Student Count</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var classroom in Model.ClassListTable)
                {
                    <tr>
                        <td>@classroom.ClassName</td>
                        <td>@classroom.StudentCount</td>
                        <td>@classroom.ClassDescription</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@classroom.Id" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                            <form method="post" asp-page-handler="Edit" asp-route-id="@classroom.Id" style="display:inline;">
                                <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (Model.PageNumber > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-FilterBy="@Model.FilterBy">Previous</a>
                    </li>
                }

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-PageNumber="@i" asp-route-FilterBy="@Model.FilterBy">@i</a>
                    </li>
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-FilterBy="@Model.FilterBy">Next</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>