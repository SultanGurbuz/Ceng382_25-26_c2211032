@page
@model MyRazorApp.Pages.Classes.IndexModel
@{
    ViewData["Title"] = "Classes";
}

<h2 class="mb-4">Class Dashboard</h2>

<div class="row">

    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white">
                @(Model.IsEdit ? "Edit Class" : "Add New Class")
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="@((Model.IsEdit ? "Update" : "Add"))">
                    <input type="hidden" asp-for="ClassInformation.Id" />

                    <div class="mb-3">
                        <label asp-for="ClassInformation.Name" class="form-label fw-bold"></label>
                        <input asp-for="ClassInformation.Name" class="form-control" />
                        <span asp-validation-for="ClassInformation.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClassInformation.StudentCount" class="form-label fw-bold">Student Count</label>
                        <input asp-for="ClassInformation.StudentCount" type="number" min="0" class="form-control" />
                        <span asp-validation-for="ClassInformation.StudentCount" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClassInformation.Description" class="form-label fw-bold"></label>
                        <textarea asp-for="ClassInformation.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="ClassInformation.Description" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        @((Model.IsEdit ? "Update" : "Add")) Class
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white">Class List</div>
            <div class="card-body">

                <form method="get" class="mb-3" id="filter-form">
                    <input type="text" name="FilterBy" value="@Model.FilterBy"
                           placeholder="🔍 Search class name or description..."
                           class="form-control form-control-lg border-info"
                           id="filter-input" autocomplete="off" />
                </form>

                <form method="post" asp-page-handler="ExportJson" id="export-form" class="mb-4">
                    <input type="hidden" name="SelectedCols" id="SelectedCols" />
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        📤 Export to JSON
                    </button>
                </form>

                <table class="table table-striped" id="class-table">
                    <thead>
                        <tr>
                            <th data-col="Name">Name</th>
                            <th data-col="StudentCount">Student Count</th>
                            <th data-col="Description">Description</th>
                            <th style="width:120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.ClassListTable)
                        {
                            <tr>
                                <td>@row.ClassName</td>
                                <td>@row.StudentCount</td>
                                <td>@row.ClassDescription</td>
                                <td>
                                    <form method="post" asp-page-handler="Edit" asp-route-id="@row.Id" class="d-inline">
                                        <button type="submit" class="btn btn-warning btn-sm me-1">
                                            ✏️ Edit
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@row.Id" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this class?');">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            🗑️ Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav>
                    <ul class="pagination">

                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                            <form method="get" class="d-inline">
                                <input type="hidden" name="FilterBy" value="@Model.FilterBy" />
                                <input type="hidden" name="PageNumber" value="@(Model.PageNumber - 1)" />
                                <button class="page-link">Previous</button>
                            </form>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <form method="get" class="d-inline">
                                    <input type="hidden" name="FilterBy" value="@Model.FilterBy" />
                                    <input type="hidden" name="PageNumber" value="@i" />
                                    <button class="page-link">@i</button>
                                </form>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            <form method="get" class="d-inline">
                                <input type="hidden" name="FilterBy" value="@Model.FilterBy" />
                                <input type="hidden" name="PageNumber" value="@(Model.PageNumber + 1)" />
                                <button class="page-link">Next</button>
                            </form>
                        </li>
                    </ul>
                </nav>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Table header column selector
    document.querySelectorAll('#class-table thead th[data-col]').forEach(th => {
        th.addEventListener('click', () => {
            th.classList.toggle('table-info');
            const col = th.dataset.col;
            const field = document.getElementById('SelectedCols');
            const list = field.value ? field.value.split(',') : [];
            field.value = list.includes(col)
                ? list.filter(x => x !== col).join(',')
                : [...list, col].join(',');
        });
    });

    // Debounced filter input (500ms delay)
    let filterTimeout;
    const filterInput = document.getElementById('filter-input');
    filterInput.addEventListener('input', function () {
        clearTimeout(filterTimeout);
        filterTimeout = setTimeout(() => {
            document.getElementById('filter-form').submit();
        }, 500);
    });
</script>
}

<style>
thead th.table-info      { background: #bee5eb; cursor: pointer; }
thead th[data-col]:hover { background: #d0f0f5; }

.card-header {
    font-weight: bold;
    font-size: 1.1rem;
}
</style>
