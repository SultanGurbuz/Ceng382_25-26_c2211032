@page
@model MyRazorApp.Pages.DashboardModel
@{
    ViewData["Title"] = "Class List";
    Layout = "_Layout";
}

<h1>Class List</h1>
@if (TempData["ExportError"] != null)
{
    <div class="alert alert-danger">@TempData["ExportError"]</div>
}
@if (TempData["ExportSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ExportSuccess"]</div>
}
@if (TempData["DeleteSuccess"] != null)
{
    <div class="alert alert-success">@TempData["DeleteSuccess"]</div>
}
@if (TempData["UpdateSuccess"] != null)
{
    <div class="alert alert-success">@TempData["UpdateSuccess"]</div>
}
<div class="row">
    <div class="col-md-6">
        <h2>@(Model.IsEdit ? "Edit Class" : "Add New Class")</h2>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <form method="post" asp-page-handler="@(Model.IsEdit ? "Update" : "Add")">
            <input type="hidden" asp-for="ClassInformation.Id" />
            
            <div class="form-group mb-3">
                <label asp-for="ClassInformation.ClassName"></label>
                <input asp-for="ClassInformation.ClassName" class="form-control" 
                       readonly="@(Model.IsEdit)" />
                <span asp-validation-for="ClassInformation.ClassName" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="ClassInformation.StudentCount"></label>
                <input asp-for="ClassInformation.StudentCount" class="form-control" type="number" />
                <span asp-validation-for="ClassInformation.StudentCount" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="ClassInformation.ClassDescription"></label>
                <input asp-for="ClassInformation.ClassDescription" class="form-control" />
                <span asp-validation-for="ClassInformation.ClassDescription" class="text-danger"></span>
            </div>
            
            <div class="mt-3">
                @if (Model.IsEdit)
                {   <!-- Changed from ./Index to ./Dashboard-->
                    <button type="submit" class="btn btn-warning">Update</button>
                    <a asp-page="./Dashboard"
                       asp-route-FilterBy="@Model.FilterBy" 
                       asp-route-PageNumber="@Model.PageNumber" 
                       class="btn btn-secondary">Cancel</a>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">Add</button>
                }
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <h2>Class List</h2>
        <div class="form-group mb-3">
            <label for="FilterBy">Filter by Class Name or Description</label>
            <input id="FilterBy"
                   name="FilterBy"
                   value="@Model.FilterBy"
                   class="form-control"
                   oninput="applyFilter(this.value)" />
        </div>

        <div class="mt-4 mb-3"></div>
            <form method="post" asp-page-handler="ExportJson">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-file-export"></i> Export
                </button>
            </form>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th class="@(Model.ExportOptions.ExportClassName ? "bg-success" : "")">
                        <a asp-page-handler="ToggleColumn"
                           asp-route-columnName="ClassName"
                           asp-route-FilterBy="@Model.FilterBy"
                           asp-route-PageNumber="@Model.PageNumber"
                           class="text-decoration-none @(Model.ExportOptions.ExportClassName ? "text-white" : "text-dark")">
                            Class Name
                        </a>
                    </th>
                    
                    <th class="@(Model.ExportOptions.ExportStudentCount ? "bg-success" : "")">
                        <a asp-page-handler="ToggleColumn"
                           asp-route-columnName="StudentCount"
                           asp-route-FilterBy="@Model.FilterBy"
                           asp-route-PageNumber="@Model.PageNumber"
                           class="text-decoration-none @(Model.ExportOptions.ExportStudentCount ? "text-white" : "text-dark")">
                            Student Count
                        </a>
                    </th>
                    
                    <th class="@(Model.ExportOptions.ExportClassDescription ? "bg-success" : "")">
                        <a asp-page-handler="ToggleColumn"
                           asp-route-columnName="ClassDescription"
                           asp-route-FilterBy="@Model.FilterBy"
                           asp-route-PageNumber="@Model.PageNumber"
                           class="text-decoration-none @(Model.ExportOptions.ExportClassDescription ? "text-white" : "text-dark")">
                            Description
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.ClassListTable)
                {
                    <tr>
                        <td class="@(Model.ExportOptions.ExportClassName ? "" : "text-muted")">
                            @c.ClassName
                        </td>
                        
                        <td class="@(Model.ExportOptions.ExportStudentCount ? "" : "text-muted")">
                            @c.StudentCount
                        </td>
                        
                        <td class="@(Model.ExportOptions.ExportClassDescription ? "" : "text-muted")">
                            @c.ClassDescription
                        </td>
                        
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                            <form method="post" asp-page-handler="Edit" asp-route-id="@c.Id" style="display:inline;">
                                <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (Model.PageNumber > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="javascript:void(0)" onclick="navigateToPage(@(Model.PageNumber - 1))">Previous</a>
                    </li>
                }
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="javascript:void(0)" onclick="navigateToPage(@i)">@i</a>
                    </li>
                }
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="javascript:void(0)" onclick="navigateToPage(@(Model.PageNumber + 1))">Next</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        function debounce(fn, ms) {
            let timer;
            return (...args) => {
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(this, args), ms);
            };
        }
        const applyFilter = debounce(val => {
            window.location.href = `?FilterBy=${encodeURIComponent(val)}&PageNumber=1`;
        }, 300);

        function navigateToPage(page) {
            const val = document.getElementById('FilterBy').value;
            window.location.href = `?FilterBy=${encodeURIComponent(val)}&PageNumber=${page}`;
        }
    </script>
}